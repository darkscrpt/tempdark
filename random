    obj.Name.Size = Features.ESP.FontSize
    obj.Name.Center = true
    obj.Health.Visible = false
    obj.Health.Color = Features.ESP.HealthColorNormal
    obj.Health.Size = Features.ESP.FontSize
    obj.Health.Center = true
    obj.Distance.Visible = false
    obj.Distance.Color = Color3.new(1, 1, 1)
    obj.Distance.Size = Features.ESP.FontSize
    obj.Distance.Center = true
    return obj
end

local function UpdateESP()
    if not Features.ESP.Enabled then
        -- Hide all objects
        for _, obj in pairs(ESPObjects) do
            obj.Box.Visible = false
            obj.Name.Visible = false
            obj.Health.Visible = false
            obj.Distance.Visible = false
            for _, line in ipairs(obj.Skeleton) do
                line.Visible = false
            end
        end
        return
    end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local teamFilter = Features.ESP.TeamFilter
    local checkVisible = Features.ESP.CheckVisible

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if not (root and head and hum and hum.Health > 0) then continue end

        -- Team filter
        local isEnemy = player:GetAttribute("TeamID") ~= LocalPlayer:GetAttribute("TeamID")
        if teamFilter == "Enemy" and not isEnemy then continue end
        if teamFilter == "Ally" and isEnemy then continue end

        -- Visibility check
        if checkVisible then
            local ray = Ray.new(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * 1000)
            local hit = workspace:FindPartOnRay(ray, myChar)
            if hit and hit:IsDescendantOf(char) == false then continue end
        end

        -- Get or create ESP object for player
        local obj = ESPObjects[player]
        if not obj then
            obj = CreateESPObject()
            ESPObjects[player] = obj
            if not obj then return end
        end

        local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then
            obj.Box.Visible = false
            obj.Name.Visible = false
            obj.Health.Visible = false
            obj.Distance.Visible = false
            for _, line in ipairs(obj.Skeleton) do line.Visible = false end
            continue
        end

        -- Calculate box size based on distance
        local dist = (myRoot.Position - root.Position).Magnitude
        local size = math.clamp(200 / dist, 0.5, 2) * 50
        local x, y = vector.X, vector.Y
        local boxSize = size * 0.8

        -- Update Box
        if Features.ESP.ShowBox then
            obj.Box.Visible = true
            obj.Box.Size = Vector2.new(boxSize, boxSize * 1.2)
            obj.Box.Position = Vector2.new(x - boxSize/2, y - boxSize*0.6)
            obj.Box.Color = Features.ESP.BoxColor
            obj.Box.Thickness = Features.ESP.LineThickness
        else
            obj.Box.Visible = false
        end

        -- Update Name
        if Features.ESP.ShowName then
            obj.Name.Visible = true
            obj.Name.Text = player.Name
            obj.Name.Position = Vector2.new(x, y - boxSize*0.6 - 20)
            obj.Name.Color = Features.ESP.NameColor
            obj.Name.Size = Features.ESP.FontSize
        else
            obj.Name.Visible = false
        end

        -- Update Health
        if Features.ESP.ShowHealth then
            obj.Health.Visible = true
            local healthPercent = hum.Health / hum.MaxHealth
            obj.Health.Text = string.format("%.0f%%", healthPercent * 100)
            obj.Health.Position = Vector2.new(x, y + boxSize*0.6 + 5)
            obj.Health.Color = healthPercent < 0.3 and Features.ESP.HealthColorLow or Features.ESP.HealthColorNormal
            obj.Health.Size = Features.ESP.FontSize
        else
            obj.Health.Visible = false
        end

        -- Update Distance
        if Features.ESP.ShowDistance then
            obj.Distance.Visible = true
            obj.Distance.Text = string.format("%.0fm", dist)
            obj.Distance.Position = Vector2.new(x, y + boxSize*0.6 + 25)
            obj.Distance.Color = Color3.new(1, 1, 1)
            obj.Distance.Size = Features.ESP.FontSize
        else
            obj.Distance.Visible = false
        end

        -- Skeleton (simple: connect head, arms, legs)
        if Features.ESP.ShowSkeleton then
            -- Rebuild skeleton lines if not enough
            while #obj.Skeleton < 8 do
                local line = Drawing.new("Line")
                line.Visible = false
                line.Thickness = 2
                line.Color = Features.ESP.SkeletonColor
                table.insert(obj.Skeleton, line)
            end

            local function worldToScreen(pos)
                local v, on = Camera:WorldToViewportPoint(pos)
                if on then return Vector2.new(v.X, v.Y) end
                return nil
            end

            local headPos = worldToScreen(head.Position)
            local rootPos = worldToScreen(root.Position)
            local leftArm = char:FindFirstChild("LeftUpperArm")
            local rightArm = char:FindFirstChild("RightUpperArm")
            local leftLeg = char:FindFirstChild("LeftUpperLeg")
            local rightLeg = char:FindFirstChild("RightUpperLeg")

            if headPos and rootPos then
                local points = {
                    headPos, rootPos,
                    headPos, leftArm and worldToScreen(leftArm.Position) or headPos,
                    headPos, rightArm and worldToScreen(rightArm.Position) or headPos,
                    rootPos, leftLeg and worldToScreen(leftLeg.Position) or rootPos,
                    rootPos, rightLeg and worldToScreen(rightLeg.Position) or rootPos,
                }
                for i = 1, #points, 2 do
                    local idx = (i-1)/2 + 1
                    if idx <= #obj.Skeleton then
                        local line = obj.Skeleton[idx]
                        if points[i] and points[i+1] then
                            line.Visible = true
                            line.From = points[i]
                            line.To = points[i+1]
                            line.Color = Features.ESP.SkeletonColor
                            line.Thickness = 2
                        else
                            line.Visible = false
                        end
                    end
                end
            else
                for _, line in ipairs(obj.Skeleton) do line.Visible = false end
            end
        else
            for _, line in ipairs(obj.Skeleton) do line.Visible = false end
        end
    end

    -- Remove ESP objects for players that left
    for player, obj in pairs(ESPObjects) do
        if not player or not player.Parent then
            obj.Box.Visible = false
            obj.Name.Visible = false
            obj.Health.Visible = false
            obj.Distance.Visible = false
            for _, line in ipairs(obj.Skeleton) do line.Visible = false end
            ESPObjects[player] = nil
        end
    end
end

-- Run ESP update loop
local espConnection
local function ToggleESP(enabled)
    Features.ESP.Enabled = enabled
    if enabled then
        if not espConnection then
            espConnection = RunService.RenderStepped:Connect(UpdateESP)
        end
    else
        if espConnection then
            espConnection:Disconnect()
            espConnection = nil
        end
        -- Hide all ESP objects
        for _, obj in pairs(ESPObjects) do
            obj.Box.Visible = false
            obj.Name.Visible = false
            obj.Health.Visible = false
            obj.Distance.Visible = false
            for _, line in ipairs(obj.Skeleton) do line.Visible = false end
        end
    end
end

