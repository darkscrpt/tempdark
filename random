MiscLeft:AddToggle("SkinChangerEnabled", {
    Text = "Enable Skin Changer",
    Default = false,
    Tooltip = "Unlocks all skins, charms, dances, and wraps (excludes finishers)",
    Callback = function(enabled)
        if enabled then
            Library:Notify({ Title = "Skin Changer", Description = "All cosmetics unlocked! (No finishers)", Time = 3 })
        end
        Features.SkinChanger.Enabled = enabled
    end,
})

MiscLeft:AddButton({
